{
  "name": "underrealm",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "catalog": "python3 tools/stage_assets.py",
    "verify:assets": "node tools/verify-catalog.mjs",
    "test": "vitest run",
    "verify": "vitest run && npm run verify:contracts",
    "verify:economy": "vitest run src/game/rules/money.test.ts scripts/economy-sim.test.ts",
    "verify:contracts": "cargo test --manifest-path contracts/Cargo.toml -p underrealm-core -p underrealm-engine -p underrealm-game -p underrealm-deeds -p underrealm-deed-controller",
    "verify:replay": "node scripts/verify-replay.mjs",
    "verify:testnet": "node scripts/verify-testnet.mjs",
    "verify:mainnet": "node scripts/verify-mainnet.mjs",
    "mock:seed": "vitest run src/blockchain/MockChain.test.ts",
    "mock:reset": "vitest run src/blockchain/MockChain.test.ts"
  },
  "dependencies": {
    "@studio-freight/lenis": "^1.0.42",
    "gsap": "^3.12.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vitest": "^5.1.0"
  }
}
